# ==== Banco de dados (MongoDB Atlas) ====
MONGODB_URI="mongodb+srv://usuario:senha@seu-cluster.mongodb.net/jw-joalheria?retryWrites=true&w=majority"

# Porta do servidor Express
PORT=4000

# ==== Firebase Admin SDK (autenticação do painel) ====
# Gere em: Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# E-mails autorizados a acessar o painel administrativo (separados por virgula)
ADMIN_EMAILS=janayna@jwjoalheria.com

# ==== Cloudinary (imagens de produtos e avaliacoes) ====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== Frete (Correios) ====
# CEP de origem da loja/joalheria (nunca informado pelo cliente).
CORREIOS_CEP_ORIGEM=

# Código do serviço dos Correios usado na cotação (ex.: PAC, SEDEX).
# Depende do contrato da joalheria com os Correios. Também chamado de
# "coProduto" na documentação oficial (ex.: 03298 = PAC Contrato Agência).
CORREIOS_SERVICE_CODE=

# Tipo do objeto postado, exigido pela API de Preço dos Correios:
# 1 = Envelope | 2 = Pacote/Caixa | 3 = Rolo/Prisma.
# Uma joia embalada em caixa usa "2" (padrão).
CORREIOS_TIPO_OBJETO=2

# Prazo fixo de produção da joia, em dias uteis. Somado ao prazo de
# transporte retornado pelos Correios para compor o prazo total.
PRODUCTION_DAYS=15

# Embalagem: configuracao GLOBAL (nao fica no produto individualmente).
# Os valores abaixo sao um ponto de partida e devem ser atualizados quando
# a proprietaria informar o peso/medidas reais da embalagem utilizada.
CORREIOS_PACKAGING_WEIGHT_GRAMS=300
CORREIOS_PACKAGE_LENGTH_CM=15
CORREIOS_PACKAGE_WIDTH_CM=11
CORREIOS_PACKAGE_HEIGHT_CM=1

# Credenciais da API dos Correios (https://api.correios.com.br), obtidas no
# portal CWS (https://cws.correios.com.br) apos contrato ativo com os
# Correios. Dependem do contrato comercial da joalheria — NAO invente
# valores aqui. Enquanto nao configuradas, o calculo de frete retorna um
# erro claro em vez de simular uma resposta.
CORREIOS_API_BASE_URL=https://api.correios.com.br
# Usuario Meu Correios (ou codigo de acesso a API gerado no CWS) e senha.
CORREIOS_API_USERNAME=
CORREIOS_API_PASSWORD=
# Cartao de postagem do contrato (geralmente comeca com 00). Obrigatorio.
CORREIOS_API_CARTAO_POSTAGEM=
# Numero do contrato e DR (Diretoria Regional/Superintendencia Estadual).
# Opcionais para a autenticacao por cartao de postagem, mas alguns
# contratos/servicos exigem informa-los na cotacao de preco.
CORREIOS_API_CONTRATO=
CORREIOS_API_DR=
CORREIOS_API_TIMEOUT_MS=10000