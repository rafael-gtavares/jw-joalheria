# ==== Banco de dados (MongoDB Atlas) ====
# Cole aqui a Connection String do Atlas (Driver: Node.js).
# Ela já inclui usuário e senha. Substitua <username>, <password> e o cluster.
# Importante: coloque o nome do banco depois do "/" (ex.: /jw-joalheria)
MONGODB_URI="mongodb+srv://rafaeltavaresinformatica_db_user:SUA_SENHA@SEU-CLUSTER.mongodb.net/jw-joalheria?retryWrites=true&w=majority"

# (Opcional) Guardados separadamente só para referência — o server usa apenas MONGODB_URI acima.
MONGODB_USERNAME="rafaeltavaresinformatica_db_user"
MONGODB_PASSWORD="SUA_SENHA"

# ==== Segurança / Admin ====
# Gere uma chave forte (ex.: openssl rand -base64 32)
JWT_SECRET=troque_essa_chave_secreta

# Porta do servidor Express
PORT=4000

# Login do painel administrativo (usado pelo comando de seed)
ADMIN_EMAIL=janayna@jwjoalheria.com
ADMIN_PASSWORD=troque_essa_senha
