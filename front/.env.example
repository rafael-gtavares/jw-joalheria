# Credenciais publicas do app Firebase (Console > Configuracoes do projeto > Geral > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL base da API (opcional). Sem ela o front usa "/api" (proxy do Vite em dev,
# rewrite da Vercel em producao). Nenhuma credencial do Mercado Pago fica aqui:
# o checkout e feito por redirecionamento e o token fica so no back-end.
VITE_API_URL=
